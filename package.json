{
  "name": "design-ways-of-work",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "check:chunk": "yarn -s lint:files && yarn -s format:check && yarn -s lint && yarn -s tsc && yarn -s lint:copies && yarn -s lint:exports",
    "tsc": "tsc --noEmit",
    "lint": "eslint .",
    "lint:files": "node scripts/lint-files.ts",
    "lint:copies": "jscpd --min-tokens 50 --format typescript --reporters console --no-tips --exit-code 1 scripts shared/hooks shared/lint design-system knip.ts",
    "lint:exports": "knip --no-progress",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check . --log-level warn",
    "test": "yarn -s check:chunk && node scripts/verify.ts",
    "prepare": "husky",
    "rehearse": "node scripts/rehearse.ts",
    "verify": "node scripts/verify.ts",
    "take-dev-map": "node scripts/take-dev-map.ts",
    "port-save": "node scripts/port-save.ts",
    "take-dev-claude": "node scripts/take-dev-claude.ts"
  },
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@ls-lint/ls-lint": "2.3.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.10.0",
    "eslint-plugin-import-x": "4.18.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jiti": "2.4.2",
    "jscpd": "5.4.3",
    "jsdom": "30.0.1",
    "knip": "6.44.2",
    "lucide-static": "1.69.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "rolldown": "1.2.16",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
