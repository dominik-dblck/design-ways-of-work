{
  "name": "design-ways-of-work",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "check:chunk": "node shared/hooks/checkTier.ts commit",
    "check:feature": "node shared/hooks/checkTier.ts feature",
    "test:rules": "vitest run tests/lint",
    "test:shared": "vitest run shared/tests",
    "test:tools": "vitest run tests/sync tests/design-system tests/scripts tests/hooks tests/browser",
    "test:mechanism": "vitest run tests/mechanism",
    "sync:groups": "node shared/sync/syncGroups.ts",
    "tsc": "tsc --noEmit",
    "lint": "eslint .",
    "lint:files": "node scripts/lintFiles.ts",
    "lint:words": "cspell --no-progress --no-summary",
    "lint:deps": "syncpack lint",
    "deps:dedupe": "node shared/lint/dedupe.ts",
    "lint:commit": "commitlint",
    "lint:kept": "node scripts/keepsItsRules.ts",
    "lint:copies": "jscpd --min-tokens 50 --format typescript --reporters console --no-tips --exit-code 1 scripts shared/hooks shared/lint shared/sync design-system knip.ts",
    "lint:exports": "knip --no-progress --no-config-hints",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check . --log-level warn",
    "format:files": "node shared/lint/writeFormatterFiles.ts --out .",
    "test": "yarn -s check:feature",
    "reads": "node scripts/productReads.ts",
    "fresh": "node scripts/fresh.ts",
    "consumers": "node scripts/consumers.ts",
    "release": "node scripts/release.ts",
    "hooks": "husky",
    "take-dev-map": "node scripts/takeDevMap.ts",
    "take-dev-claude": "node scripts/takeDevClaude.ts",
    "backup": "zsh scripts/zipRepo.sh"
  },
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@cspell/dict-pl_pl": "3.0.8",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@ls-lint/ls-lint": "2.3.2",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/rule-tester": "8.70.0",
    "@typescript-eslint/utils": "8.70.0",
    "cspell": "10.4.0",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jiti": "2.4.2",
    "jscpd": "5.4.3",
    "jsdom": "30.0.1",
    "knip": "6.44.2",
    "lucide-static": "1.69.0",
    "minimatch": "10.2.6",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "rolldown": "1.2.16",
    "syncpack": "15.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "yarn-deduplicate": "6.0.2"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
