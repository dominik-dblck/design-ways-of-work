{
  "name": "sample-product",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "wow": {
    "takes": [
      "design",
      "shared",
      "design-system"
    ]
  },
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "build": "node tools/build.ts",
    "checks": "node tools/build.ts && DESIGN_SAVE=1 node tools/checks.ts",
    "cut-pack": "node tools/build.ts && node tools/pack.ts",
    "apply-reports": "node tools/applyReports.ts",
    "spec-check": "node tools/build.ts && node tools/specCheck.ts",
    "lint": "ESLINT_FLAGS=unstable_native_nodejs_ts_config eslint .",
    "lint:fix": "ESLINT_FLAGS=unstable_native_nodejs_ts_config eslint . --fix",
    "tsc": "tsc --noEmit",
    "format": "prettier --write . --log-level warn",
    "format:check": "prettier --check .",
    "format:files": "node shared/lint/writeFormatterFiles.ts --out .",
    "sync:groups": "node shared/sync/syncGroups.ts",
    "test": "ESLINT_FLAGS=unstable_native_nodejs_ts_config vitest --run",
    "prepare": "husky",
    "checks:gate": "node tools/checksGate.ts",
    "test:architecture": "ESLINT_FLAGS=unstable_native_nodejs_ts_config vitest --run tests/architecture",
    "new-epic": "node tools/newEpic.ts",
    "release:record": "node tools/releaseRecord.ts",
    "lint:files": "node tools/lintFiles.ts",
    "lint:words": "cspell --no-progress --no-summary",
    "lint:deps": "syncpack lint",
    "deps:dedupe": "node shared/lint/dedupe.ts",
    "lint:commit": "commitlint",
    "check:chunk": "node shared/hooks/checkTier.ts commit",
    "check:feature": "node shared/hooks/checkTier.ts feature",
    "lint:exports": "knip --no-progress --no-config-hints --no-gitignore",
    "backup": "zsh tools/zipRepo.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@cspell/dict-pl_pl": "3.0.8",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@ls-lint/ls-lint": "2.3.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "cspell": "10.4.0",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "eslint-plugin-import-x": "4.18.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jiti": "2.4.2",
    "jsdom": "30.0.1",
    "knip": "6.44.2",
    "minimatch": "10.2.6",
    "prettier": "3.9.6",
    "rolldown": "1.2.16",
    "syncpack": "15.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "yarn-deduplicate": "6.0.2"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "lucide-react": "1.69.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
