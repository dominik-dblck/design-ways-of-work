{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node tools/keepsTheTurn.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node shared/hooks/edit-check.ts && node tools/keepsTheTurn.ts"
          }
        ]
      }
    ]
  }
}
