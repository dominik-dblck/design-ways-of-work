{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ESLINT_FLAGS=unstable_native_nodejs_ts_config node shared/hooks/editCheck.ts",
            "timeout": 60,
            "statusMessage": "Prettier and ESLint on the edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node tools/runKeepsTheTurn.ts",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node shared/hooks/chunkCheck.ts",
            "timeout": 300,
            "statusMessage": "The commit tier's checks"
          }
        ]
      }
    ]
  }
}
