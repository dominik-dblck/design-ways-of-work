+/**
+ * - `ListLogic`, `LIST_REACT` · the base class and React the list logic reaches
+ */
+
+// the list's harness never redraws: its state is set before each read
+class ListLogic {
+  props: unknown;
+  constructor(props?: unknown) {
+    this.props = props || {};
+  }
+  setState(): void {
+    this.props = Object(this.props);
+  }
+  forceUpdate(): void {
+    this.props = Object(this.props);
+  }
+}
+
+const LIST_REACT = { createRef: (): object => ({}) };
+
+export { LIST_REACT, ListLogic };
