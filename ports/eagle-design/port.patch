+      { name: '--type-push-bg', light: 'var(--b-25)', dark: '#1b2440' },
+      { name: '--type-push-fg', light: 'var(--b-400)', dark: 'var(--b-50)', why: '5.80', whyDark: '10.84' },
+      { name: '--type-banner-bg', light: 'var(--o-50)', dark: '#3a2a12', why: 'the app banner · T-E06-13' },
+      { name: '--type-banner-fg', light: 'var(--n-800)', dark: 'var(--o-50)' },
+    ],
+  },
