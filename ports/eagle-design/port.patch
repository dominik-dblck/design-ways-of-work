+      { name: '--st-review-fg', light: '#8a6a00', dark: 'var(--y-100)', why: '4.71 · y-500 (#a47c05) reads 3.57 — a y-600 the DS ramp lacks', whyDark: '9.75' },
+      { name: '--st-ready-bg', light: 'var(--g-50)', dark: '#12332f' },
+      { name: '--st-ready-fg', light: 'var(--g-600)', dark: 'var(--g-200)', why: '5.56', whyDark: '9.26' },
+      { name: '--st-published-bg', light: '#e4f5e3', dark: '#15291a' },
+      { name: '--st-published-fg', light: '#1f6b2a', dark: '#8fdc98', why: '5.78 · a document handed to its destination (PM, 6 Nov)', whyDark: '9.43' },
+    ],
+  },
+  {
+    title: 'TYPE CHIPS · email, push',
+    intro: '',
+    darkNote: 'type chips\n\nthe one wash the DS blue ramp lacks · in dark it is a deep tint, not a wash',
+    entries: [
+      { name: '--type-email-bg', light: 'var(--n-50)', dark: '#282828' },
