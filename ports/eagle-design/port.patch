+];
+
+const homeOf = (fact: string): FactHome | null =>
+  FACT_HOMES.find((home) => home.fact === fact) ?? null;
+
+// the file a home names, before its first · or (
+const fileOf = (said: unknown): string =>
+  String(said).split(' · ')[0]?.split(' (')[0] ?? '';
+
+// a move that makes it: added · named by a move, today or target: changes · else the same
+function fileStanding(file: string): string {
+  const own = fileOf(file);
+  const named = FACT_HOMES.filter(
+    (home) => fileOf(home.today) === own || fileOf(home.target) === own,
+  );
+  if (named.some((home) => home.new && fileOf(home.target) === own))
+    return 'added';
+  return named.length ? 'changes' : 'same';
+}
+
+// the rows that still move, file to file
+const moving = (rows: readonly FactHome[]): readonly FactHome[] =>
+  rows.filter(
+    (home) => !home.done && fileOf(home.today) !== fileOf(home.target),
+  );
+
+const factMoves = (): FileFlow['moves'] =>
+  moving(FACT_HOMES).map((home) => ({
+    fact: home.fact,
+    from: fileOf(home.today),
+    to: fileOf(home.target),
+    by: home.by || '',
+  }));
+
+export { FACT_HOMES, factMoves, fileOf, homeOf, moving, fileStanding };
