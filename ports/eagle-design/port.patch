+/**
+ * - `blockModel` · the block model as data, its parts in key order
+ * - `modelTypes`, `ModelType` · its types, each a name and its src lines
+ */
+import { ANSWERS_TO_NOTE } from './blockModel/answersToNote.ts';
+import { SETTLED_FROM1 } from './blockModel/settledFrom1.ts';
+import { SETTLED_FROM25 } from './blockModel/settledFrom25.ts';
+import { VERDICT_TO_MATRIX } from './blockModel/verdictToMatrix.ts';
+import { LEVELS_TO_ATTACHED } from './blockModel/levelsToAttached.ts';
+import { TYPES_ALIASES } from './blockModel/typesAliases.ts';
+import { TYPES_GATE_FACTS } from './blockModel/typesGateFacts.ts';
+import { TYPES_EXPORT } from './blockModel/typesExport.ts';
+import { TYPES_PROPOSAL_ROOT } from './blockModel/typesProposalRoot.ts';
+import { TYPES_ASSET } from './blockModel/typesAsset.ts';
+import { THREADS_TO_PICTURES } from './blockModel/threadsToPictures.ts';
+
+const blockModel = {
+  ...ANSWERS_TO_NOTE,
+  settled: [...SETTLED_FROM1, ...SETTLED_FROM25],
+  ...VERDICT_TO_MATRIX,
+  ...LEVELS_TO_ATTACHED,
+  types: [
+    ...TYPES_ALIASES,
+    ...TYPES_GATE_FACTS,
+    ...TYPES_EXPORT,
+    ...TYPES_PROPOSAL_ROOT,
+    ...TYPES_ASSET,
+  ],
+  ...THREADS_TO_PICTURES,
+} as const;
+
+interface ModelType {
+  readonly name: string;
+  readonly src?: string | readonly string[];
+}
+
+const modelTypes: readonly ModelType[] = blockModel.types;
+
+export { blockModel, modelTypes };
+export type { ModelType };
