+  'scenes.js',
+  'translationFlow.js',
+  'roleCombinations.js',
+  'approvalLogic.js',
+  'sheetStatus.js',
+  'deliveryFlow.js',
+  'contentCheck.js',
+  'contentTypeLogic.js',
+  'catalog.js',
+  'contentSamples.js',
+  'contentList.js',
+  'screenView.js',
+  'wireframes.js',
+];
+
+function legacyWorld(mirror: Mirror): World {
