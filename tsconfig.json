{
  "extends": "./shared/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "shared/hooks/**/*.ts",
    "shared/lint/**/*.ts",
    "shared/repoScope.ts",
    "shared/tests/**/*.ts",
    "scope.ts",
    "design-system/**/*.ts",
    "tests/**/*.ts",
    "eslint.config.ts",
    "knip.ts",
    "vitest.config.ts"
  ],
  "exclude": ["tests/lint/fixtures/**"]
}
