{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "shared/hooks/**/*.ts",
    "shared/lint/**/*.ts",
    "design-system/**/*.ts",
    "tests/**/*.ts",
    "eslint.config.ts",
    "knip.ts"
  ],
  "exclude": ["tests/lint/fixtures/**"]
}
